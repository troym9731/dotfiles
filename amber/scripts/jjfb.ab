// Create a Jujutsu (jj) feature bookmark.
//
// The jj counterpart to `gcfb`. Puts a bookmark that follows our naming
// conventions on the revision you specify (e.g. `@` or `@-`). It does not
// create a new change or set a description — run `jj new` yourself first if
// that's what you want.
//
// Prompts the user for a Jira issue using the Jira CLI configuration, then
// creates the bookmark on the given revision.
//
// USAGE:
//   jjfb <revision>
//
// OPTIONS:
//   -n, --dry-run
//     Print the bookmark that would be created without mutating the
//     repository.
import { ensure } from "../utils.ab"
import { echo_error } from "std/env"

main (args) {
    ensure("fzf")
    ensure("jira")
    ensure("jj")

    let dry_run = has_flag(arg, "--dry-run")
    let pos = positionals(args)

    if len(pos) == 0 {
        echo_error("usage: dfm <install|link|clean|update> [env] [--dry-run]")
    }

    let cmd = pos[0]
    let env = get_env(pos)
    if {
        cmd == "install" {
            cmd_install(env, dry_run)
        }
        cmd == "link" {
            cmd_link(env, dry_run)
        }
        cmd == "clean" {
            cmd_clean(env, dry_run)
        }
        cmd == "update" {
            cmd_update(env, dry_run)
        }
        else {
            echo_error("unknown command: {cmd}")
        }
    }
}

fun get_env(pos: [Text], dry_run: Bool) {
    let env = ""
    if len(pos) >= 2 {
        env = pos[1]
    } else {
        env = resolve_saved_env()
    }
}
