  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJU874AS/TP0/PfqMF7xHY6SDvejhjQPwr1YY5+j/cLq

[push]
  default = simple

[core]
  editor = vim
  ignorecase = true
  excludesfile = /Users/troymullaney/.dotfiles/gitignore
  pager = delta

[init]
	defaultBranch = main

[credential]
	helper = osxkeychain

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true  # use n and N to move between diff sections
  side-by-side = true

[merge]
  conflictStyle = zdiff3
